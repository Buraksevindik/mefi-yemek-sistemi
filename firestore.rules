rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
             request.auth.token.email == "sevindikburak2004@gmail.com";
    }

    function isAuthorizedUser() {
      return signedIn() && (
        isAdmin() || 
        request.auth.token.email.matches('.*@akdogan[.]tech')
      );
    }

    // =========================
    // MENÜLER
    // =========================
    match /menuler/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================
    // STAJYERLER
    // =========================
    match /stajyerler/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================
    // SAYAÇLAR (Sıra numarası için)
    // =========================
    match /sayaclar/{docId} {
      allow read, write: if isAuthorizedUser();
    }

    // =========================
    // SİPARİŞLER
    // =========================
    match /siparisler/{docId} {

      allow get: if signedIn() && (
        isAdmin() || 
        resource.data.uid == request.auth.uid
      );

      allow list: if signedIn();

      allow create: if isAuthorizedUser() && 
                    request.resource.data.uid == request.auth.uid;

      allow update: if signedIn() && (
        isAdmin() || 
        resource.data.uid == request.auth.uid
      );

      allow delete: if signedIn() && (
        isAdmin() || 
        resource.data.uid == request.auth.uid
      );
    }
  }
}