rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
             request.auth.token.email == "sevindikburak2004@gmail.com";
    }

    // =========================
    // MENÜLER
    // =========================
    match /menuler/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================
    // STAJYERLER
    // =========================
    match /stajyerler/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================
    // SAYAÇLAR (Sıra numarası için)
    // =========================
    match /sayaclar/{docId} {
      // Giriş yapmış kullanıcılar sayaç okuyabilir/güncelleyebilir
      allow read, write: if signedIn();
    }

    // =========================
    // SİPARİŞLER
    // =========================
    match /siparisler/{docId} {

      allow get: if signedIn() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid
      );

      allow list: if signedIn();

      allow create: if signedIn() &&
                    request.resource.data.uid == request.auth.uid;

      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid
      );

      allow delete: if signedIn() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid
      );
    }

    // =========================
    // KAPALI GÜNLER
    // =========================
    match /kapaliGunler/{gun} {

      // Giriş yapmış herkes kapalı günleri görebilir
      allow read: if signedIn();

      // Sadece admin kapalı gün ekleyebilir/silebilir/değiştirebilir
      allow write: if isAdmin();
    }
  }
}